{
  "name": "widget-trip-agent",
  "version": "1.0.0",
  "description": "Paw Plan — Agent Journey Widget for multi-project coding companions",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "dependencies": {
    "electron": "^33.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.pawplan.widget",
    "productName": "Paw Plan Widget",
    "copyright": "MIT",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "cmd/paw-plan-server/paw-plan-server.exe",
        "to": "paw-plan-server.exe"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "src/assets/gato_solo.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Paw Plan Widget"
    }
  },
  "license": "MIT"
}
